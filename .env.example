# Optional overrides for `docker compose up`. Copy to `.env` and fill in what
# you need - anything left unset just falls back to the backend's own
# built-in dev defaults (see backend/README.md). Only read by docker-compose.yml;
# each module also has its own .env.example for running it outside Compose.

# HMAC signing key for JWTs (32+ bytes). Leave unset to use the insecure
# dev-only fallback baked into the backend.
JWT_SECRET=

# Token lifetime in ms. Leave unset for the backend's default (7 days).
JWT_EXPIRATION_MS=

# Needed only if you want the AI endpoints to actually call Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
